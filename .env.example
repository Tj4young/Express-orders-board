# Passcode staff enter before adding or changing orders.
# The Battle TV page does not need it. Viewing is always open.
TEAM_PASSCODE=choose-a-shared-passcode

# Shared storage so Tempe and Mesa see the same board.
# Create a free Redis database at https://console.upstash.com
# or add "Upstash Redis" from the Vercel Marketplace.
# Either pair of names works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The Vercel / Upstash integration sometimes uses these names instead.
# You do not need both pairs.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
